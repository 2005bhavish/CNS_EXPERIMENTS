import java.util.Scanner;

public class HillCipher {
    static int[][] key = {{3, 3}, {2, 5}};
    static int[][] inverse = {{15, 17}, {20, 9}};

    static String process(String text, int[][] matrix) {
        text = text.toUpperCase().replaceAll("[^A-Z]", "");

        if (text.length() % 2 != 0)
            text += "X";

        String result = "";

        for (int i = 0; i < text.length(); i += 2) {
            int a = text.charAt(i) - 'A';
            int b = text.charAt(i + 1) - 'A';

            int x = (matrix[0][0] * a + matrix[0][1] * b) % 26;
            int y = (matrix[1][0] * a + matrix[1][1] * b) % 26;

            result += (char) (x + 'A');
            result += (char) (y + 'A');
        }

        return result;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter text: ");
        String text = sc.nextLine();

        String encrypted = process(text, key);
        String decrypted = process(encrypted, inverse);

        System.out.println("Encrypted: " + encrypted);
        System.out.println("Decrypted: " + decrypted);
    }
}

